#!/usr/bin/env bash
# Runs CI's checks before a push: on the working tree, then gitleaks on the commits
# the push adds. git and GitButler (`but push`) both run it through core.hooksPath,
# which `mise run setup` sets; --no-verify skips it.
# Git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

remote=$1
refs=0 tips=()
while read -r _ sha _ _; do
  refs=$((refs + 1))
  # An all-zero sha deletes the remote branch: nothing to scan.
  [[ $sha =~ ^0+$ ]] || tips+=("$sha")
done
# No ref lines (a tool that doesn't pass them): scan everything unpushed instead.
[ "$refs" -gt 0 ] || tips=(HEAD)

# As check:all: the type check is left to CI, it's too heavy to run locally.
mise run -q check:fmt ::: check:lint ::: check:test ::: check:docs ::: check:workflows </dev/null
[ ${#tips[@]} -gt 0 ] || exit 0

# What the push adds: commits not yet on any of the remote's branches.
exec mise run -q check:secrets "${tips[@]}" --not --remotes="$remote" </dev/null
