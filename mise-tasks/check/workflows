#!/usr/bin/env bash
#MISE description="Audit the GitHub Actions workflows: security (zizmor) and correctness (actionlint)"
#MISE tools={"aqua:zizmorcore/zizmor"="1.30.1", "aqua:rhysd/actionlint"="1.7.12"}
#USAGE arg "[path]..." help="Files or folders for zizmor; default: the repo root, which covers .github/"
# zizmor catches unpinned actions, template injection and over-broad GITHUB_TOKEN permissions; with GH_TOKEN set
# (CI sets it, read-only) it also checks each pinned SHA belongs to the action it names. actionlint catches
# expression, shell and schema mistakes.
set -euo pipefail
rc=0
[ $# -gt 0 ] || set -- .
zizmor "$@" || rc=1
actionlint || rc=1
exit "$rc"
