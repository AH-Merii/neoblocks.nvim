#!/usr/bin/env bash
#MISE description="Lint the Lua (selene) and fail on debug output left in the plugin"
#MISE tools={"aqua:Kampfkarren/selene"="0.32.0"}
# Rules are in selene.toml and neovim.yml. The debug check covers what ships (lua/, plugin/), not tests or scripts,
# whose output is the point.
set -euo pipefail
rc=0
selene . || rc=1
if grep -rnP '^(?!\s*--).*\b(vim\.print|print|dd)\(' lua plugin; then
  echo "::error::debug output left in lua/ or plugin/ (above): use vim.notify, or remove it"
  rc=1
fi
exit "$rc"
